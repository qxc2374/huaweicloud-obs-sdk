{
    "name": "qianxiong/huaweicloud-obs-sdk",
    "description": "Modern Huawei Cloud OBS SDK for PHP 8.1+",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "guzzlehttp/guzzle": "^7.5",
        "guzzlehttp/psr7": "^2.4.5",
        "monolog/monolog": "^2.10 || ^3.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "suggest": {
        "ext-curl": "Recommended for better HTTP performance and asynchronous requests",
        "ext-openssl": "Required when accessing HTTPS OBS endpoints"
    },
    "keywords": [
        "obs",
        "huaweicloud",
        "object-storage",
        "php",
        "thinkphp",
        "laravel",
        "hyperf"
    ],
    "autoload": {
        "psr-4": {
            "QianXiong\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "scripts": {
        "lint": "@php tools/lint.php",
        "smoke": "@php tools/smoke.php",
        "test": [
            "@lint",
            "@smoke"
        ]
    }
}